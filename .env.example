# Google Cloud Platform Configuration
GCP_PROJECT_ID=cs-poc-edgd4dliruu2xvksuvo4r3g
GCP_LOCATION=us-central1

# Storage Configuration
GCS_BUCKET_BASE_NAME=tts-bank-audio
GCS_BUCKET_NAME=knowledge-to-audio-poc
# Object Expiration: 30 days default. If set to 0, no lifecycle expiration rule is applied.
GCS_OBJECT_EXPIRATION_DAYS=30

# Gemini 3 Model Family Configurations
GEMINI_VOICE_MODEL=gemini-3.1-flash-tts-preview
GEMINI_JUDGE_MODEL=gemini-3.8-flash
GEMINI_JUDGE_LOCATION=global

# Financial Services Audio Configuration
DEFAULT_VOICE_PERSONA=Retail Banking Guide
AUDIO_BITRATE=320k
AUDIO_SAMPLE_RATE=24000

# Google Cloud Identity Platform (GCIP) Authentication
GCIP_API_KEY=
GCIP_AUTH_DOMAIN=cs-poc-edgd4dliruu2xvksuvo4r3g.firebaseapp.com
ALLOWED_DOMAINS=
ALLOWED_USERS=
ENABLE_DEMO_AUTH=true

# Serverless Database Persistence (Google Cloud Firestore Native Mode)
USE_FIRESTORE=true
FIRESTORE_DATABASE=tts-jobs
FIRESTORE_COLLECTION=tts_jobs
